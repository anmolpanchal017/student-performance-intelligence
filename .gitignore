# ==========================================
# Student Performance Intelligence .gitignore
# ==========================================

# Virtual Environments
.venv/
venv/
env/
ENV/

# Environment Variables & Secrets
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Python Caches & Compiled Bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Node.js & React Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build Outputs
dist/
dist-ssr/
build/
*.egg-info/
.eggs/

# IDEs & System Files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary Files & Logs
*.log
tmp/
scratch/
